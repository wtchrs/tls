{
    "version": 2,
    "configurePresets": [
        {
            "name": "vcpkg",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "default",
            "inherits": "vcpkg",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "coverage",
            "inherits": "vcpkg",
            "binaryDir": "${sourceDir}/build-coverage",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "ENABLE_COVERAGE": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        }
    ]
}
